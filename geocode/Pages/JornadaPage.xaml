<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="geocode.Pages.JornadaPage"
    BackgroundColor="#0F172A"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid
            Padding="20,15"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="15">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="32"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#1E293B"
                TextColor="White"
                Clicked="OnVolver"/>

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center">

                <Label
                    Text="Jornadas"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Control de jornadas de trabajo"
                    FontSize="14"
                    TextColor="#94A3B8"/>

            </VerticalStackLayout>

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,10,20,30"
                Spacing="18">


                <!-- ================================================= -->
                <!-- JORNADA ACTUAL -->
                <!-- ================================================= -->

                <Frame
                    BackgroundColor="#1E293B"
                    CornerRadius="22"
                    Padding="20"
                    HasShadow="False">

                    <VerticalStackLayout Spacing="15">

                        <Label
                            Text="JORNADA ACTUAL"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#94A3B8"/>


                        <!-- SIN JORNADA -->

                        <VerticalStackLayout
                            IsVisible="{Binding HayJornadaAbierta,
                                Converter={StaticResource InverseBoolConverter}}"
                            Spacing="8">

                            <Label
                                Text="No hay una jornada abierta"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="White"/>

                            <Label
                                Text="Debes abrir una jornada antes de registrar entregas."
                                FontSize="14"
                                TextColor="#94A3B8"/>

                        </VerticalStackLayout>


                        <!-- JORNADA ABIERTA -->

                        <VerticalStackLayout
                            IsVisible="{Binding HayJornadaAbierta}"
                            Spacing="12">

                            <Grid
                                ColumnDefinitions="*,Auto">

                                <VerticalStackLayout>

                                    <Label
                                        Text="Jornada"
                                        FontSize="13"
                                        TextColor="#94A3B8"/>

                                    <Label
                                        Text="{Binding JornadaActual.Id,
                                            StringFormat='#{0}'}"
                                        FontSize="25"
                                        FontAttributes="Bold"
                                        TextColor="White"/>

                                </VerticalStackLayout>


                                <Frame
                                    Grid.Column="1"
                                    BackgroundColor="#166534"
                                    CornerRadius="15"
                                    Padding="12,7"
                                    HasShadow="False">

                                    <Label
                                        Text="● ABIERTA"
                                        TextColor="#BBF7D0"
                                        FontSize="13"
                                        FontAttributes="Bold"/>

                                </Frame>

                            </Grid>
                            <Label
    Text="CAJEROS"
    FontSize="13"
    FontAttributes="Bold"
    TextColor="#94A3B8"
    Margin="0,10,0,0"/>

                            <CollectionView
    ItemsSource="{Binding CajerosJornada}"
    SelectionMode="None">

                                <CollectionView.ItemTemplate>

                                    <DataTemplate>

                                        <Grid
                ColumnDefinitions="*,Auto"
                Padding="0,7">

                                            <VerticalStackLayout>

                                                <Label
                        Text="{Binding Nombre}"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"/>

                                                <Label
                        Text="{Binding Serie,
                            StringFormat='Serie {0}'}"
                        TextColor="#94A3B8"
                        FontSize="12"/>

                                            </VerticalStackLayout>

                                            <Label
                    Grid.Column="1"
                    Text="{Binding NumeroFacturaInicialTexto}"
                    TextColor="#60A5FA"
                    FontSize="16"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>

                                        </Grid>

                                    </DataTemplate>

                                </CollectionView.ItemTemplate>

                            </CollectionView>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="15">

                                <VerticalStackLayout>

                                    <Label
                                        Text="Inicio"
                                        FontSize="12"
                                        TextColor="#64748B"/>

                                    <Label
                                        Text="{Binding TextoFechaInicio}"
                                        FontSize="14"
                                        TextColor="#CBD5E1"/>

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1">

                                    <Label
                                        Text="Estado"
                                        FontSize="12"
                                        TextColor="#64748B"/>

                                    <Label
                                        Text="{Binding TextoEstado}"
                                        FontSize="14"
                                        TextColor="#4ADE80"/>

                                </VerticalStackLayout>

                            </Grid>


                            <Button
                                Text="Cerrar jornada"
                                HeightRequest="52"
                                CornerRadius="16"
                                BackgroundColor="#7F1D1D"
                                TextColor="White"
                                FontAttributes="Bold"
                                Command="{Binding CerrarJornadaCommand}"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================================================= -->
                <!-- ABRIR JORNADA -->
                <!-- ================================================= -->

                <Button
                    Text="＋  Abrir nueva jornada"
                    HeightRequest="56"
                    CornerRadius="17"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Command="{Binding AbrirJornadaCommand}"/>
                <Button
    Text="👤  Gestionar cajeros"
    HeightRequest="56"
    CornerRadius="17"
    BackgroundColor="#334155"
    TextColor="White"
    FontSize="16"
    FontAttributes="Bold"
    Command="{Binding GestionarCajerosCommand}"/>

                <Button
    Text="🧾  Configuraciones de facturación"
    HeightRequest="56"
    CornerRadius="17"
    BackgroundColor="#334155"
    TextColor="White"
    FontSize="16"
    FontAttributes="Bold"
    Command="{Binding GestionarConfiguracionesCommand}"/>

                <!-- ================================================= -->
                <!-- GESTIÓN DE CAJEROS -->
                <!-- ================================================= -->

                <Frame
    IsVisible="{Binding MostrarGestionCajeros}"
    BackgroundColor="#1E293B"
    CornerRadius="22"
    Padding="20"
    HasShadow="False">

                    <VerticalStackLayout
        Spacing="16">

                        <!-- HEADER -->

                        <Grid
            ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>

                                <Label
                    Text="CAJEROS"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"/>

                                <Label
                    Text="Gestiona los cajeros disponibles"
                    FontSize="13"
                    TextColor="#94A3B8"/>

                            </VerticalStackLayout>

                            <Button
                Grid.Column="1"
                Text="✕"
                WidthRequest="42"
                HeightRequest="42"
                CornerRadius="21"
                BackgroundColor="#475569"
                TextColor="White"
                Command="{Binding CancelarCajeroCommand}"/>

                        </Grid>


                        <!-- NUEVO -->

                        <Button
            Text="＋  Nuevo cajero"
            HeightRequest="52"
            CornerRadius="15"
            BackgroundColor="#2563EB"
            TextColor="White"
            FontAttributes="Bold"
            Command="{Binding NuevoCajeroCommand}"/>


                        <!-- FORMULARIO -->

                        <Frame
            IsVisible="{Binding MostrarFormularioCajero}"
            BackgroundColor="#0F172A"
            CornerRadius="16"
            Padding="15"
            HasShadow="False">

                            <VerticalStackLayout
                Spacing="12">

                                <Label
                    Text="DATOS DEL CAJERO"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#94A3B8"/>


                                <Frame
                    BackgroundColor="#334155"
                    CornerRadius="12"
                    Padding="12,0"
                    HeightRequest="52"
                    HasShadow="False">

                                    <Entry
                        Text="{Binding NombreCajero}"
                        Placeholder="Nombre del cajero"
                        PlaceholderColor="#64748B"
                        TextColor="White"
                        FontSize="16"/>

                                </Frame>


                                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                                    <Button
                        Text="CANCELAR"
                        HeightRequest="50"
                        CornerRadius="14"
                        BackgroundColor="#475569"
                        TextColor="White"
                        Command="{Binding CancelarCajeroCommand}"/>

                                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoGuardarCajero}"
                        HeightRequest="50"
                        CornerRadius="14"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        FontAttributes="Bold"
                        Command="{Binding GuardarCajeroCommand}"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- LISTA -->

                        <Label
            Text="CAJEROS REGISTRADOS"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="#94A3B8"/>


                        <CollectionView
            ItemsSource="{Binding Cajeros}"
            SelectionMode="None">

                            <CollectionView.EmptyView>

                                <Label
                    Text="No hay cajeros registrados."
                    TextColor="#64748B"
                    HorizontalOptions="Center"
                    Margin="0,20"/>

                            </CollectionView.EmptyView>


                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Frame
                        BackgroundColor="#0F172A"
                        CornerRadius="16"
                        Padding="15"
                        Margin="0,0,0,10"
                        HasShadow="False">

                                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                                            <VerticalStackLayout
                                VerticalOptions="Center">

                                                <Label
                                    Text="{Binding Nombre}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"/>

                                                <Label
                                    Text="{Binding Id,
                                        StringFormat='ID: {0}'}"
                                    TextColor="#64748B"
                                    FontSize="12"/>

                                            </VerticalStackLayout>


                                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="6">

                                                <!-- EDITAR -->

                                                <Button
                                    Text="✎"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#334155"
                                    TextColor="White"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.EditarCajeroCommand}"
                                    CommandParameter="{Binding}"/>


                                                <!-- DESACTIVAR -->

                                                <Button
                                    Text="×"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#7F1D1D"
                                    TextColor="White"
                                    IsVisible="{Binding Activo}"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.DesactivarCajeroCommand}"
                                    CommandParameter="{Binding}"/>


                                                <!-- ACTIVAR -->

                                                <Button
                                    Text="✓"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#166534"
                                    TextColor="White"
                                    IsVisible="{Binding Activo,
                                        Converter={StaticResource
                                        InverseBoolConverter}}"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.ActivarCajeroCommand}"
                                    CommandParameter="{Binding}"/>

                                            </HorizontalStackLayout>

                                        </Grid>

                                    </Frame>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>

                <!-- ================================================= -->
                <!-- NUEVA JORNADA -->
                <!-- ================================================= -->

                <Frame
    IsVisible="{Binding MostrarConfiguracionNuevaJornada}"
    BackgroundColor="#1E293B"
    CornerRadius="22"
    Padding="20"
    HasShadow="False">

                    <VerticalStackLayout Spacing="18">

                        <!-- HEADER -->

                        <Label
            Text="NUEVA JORNADA"
            FontSize="18"
            FontAttributes="Bold"
            TextColor="White"/>

                        <Label
            Text="Selecciona los cajeros y sus configuraciones de facturación."
            FontSize="14"
            TextColor="#94A3B8"/>


                        <!-- ================================================= -->
                        <!-- CAJEROS / CONFIGURACIONES -->
                        <!-- ================================================= -->

                        <CollectionView
            ItemsSource="{Binding CajerosDisponibles}"
            SelectionMode="None">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Frame
                        BackgroundColor="#0F172A"
                        CornerRadius="16"
                        Padding="15"
                        Margin="0,0,0,10"
                        HasShadow="False">

                                        <VerticalStackLayout
                            Spacing="10">


                                            <!-- ================================================= -->
                                            <!-- SELECCIÓN + INFORMACIÓN -->
                                            <!-- ================================================= -->

                                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding Seleccionado}"
                                    Color="#2563EB"
                                    VerticalOptions="Center"/>


                                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                                    <!-- CAJERO -->

                                                    <Label
                                        Text="{Binding Nombre}"
                                        TextColor="White"
                                        FontSize="16"
                                        FontAttributes="Bold"/>


                                                    <!-- SERIE -->

                                                    <Label
                                        Text="{Binding Serie,
                                            StringFormat='Serie {0}'}"
                                        TextColor="#94A3B8"
                                        FontSize="13"/>


                                                    <!-- TIPO DE FACTURACIÓN -->

                                                    <Label
                                        Text="{Binding Tipo}"
                                        TextColor="#60A5FA"
                                        FontSize="13"
                                        FontAttributes="Bold"/>

                                                </VerticalStackLayout>

                                            </Grid>


                                            <!-- ================================================= -->
                                            <!-- FACTURA INICIAL -->
                                            <!-- ================================================= -->

                                            <VerticalStackLayout
                                IsVisible="{Binding Seleccionado}"
                                Spacing="5">

                                                <Label
                                    Text="{Binding Tipo,
                                        StringFormat='Factura inicial {0}'}"
                                    TextColor="#CBD5E1"
                                    FontSize="13"/>

                                                <Frame
                                    BackgroundColor="#334155"
                                    CornerRadius="12"
                                    Padding="12,0"
                                    HasShadow="False"
                                    HeightRequest="52">

                                                    <Entry
                                        Text="{Binding NumeroFacturaInicialTexto}"
                                        Keyboard="Numeric"
                                        TextColor="White"
                                        Placeholder="Ej: 26337"
                                        PlaceholderColor="#64748B"
                                        FontSize="16"/>

                                                </Frame>

                                            </VerticalStackLayout>

                                        </VerticalStackLayout>

                                    </Frame>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>


                        <!-- ================================================= -->
                        <!-- INICIAR -->
                        <!-- ================================================= -->

                        <Button
            Text="INICIAR JORNADA"
            HeightRequest="56"
            CornerRadius="17"
            BackgroundColor="#16A34A"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            Command="{Binding IniciarJornadaCommand}"/>

                    </VerticalStackLayout>

                </Frame>
                <!-- ================================================= -->
                <!-- GESTIÓN DE CONFIGURACIONES -->
                <!-- ================================================= -->

                <Frame
    IsVisible="{Binding MostrarGestionConfiguraciones}"
    BackgroundColor="#1E293B"
    CornerRadius="22"
    Padding="20"
    HasShadow="False">

                    <VerticalStackLayout
        Spacing="16">

                        <!-- HEADER -->

                        <Grid
            ColumnDefinitions="*,Auto">

                            <VerticalStackLayout>

                                <Label
                    Text="CONFIGURACIONES"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"/>

                                <Label
                    Text="Gestiona las series de facturación"
                    FontSize="13"
                    TextColor="#94A3B8"/>

                            </VerticalStackLayout>

                            <Button
                Grid.Column="1"
                Text="✕"
                WidthRequest="42"
                HeightRequest="42"
                CornerRadius="21"
                BackgroundColor="#475569"
                TextColor="White"
                Command="{Binding CancelarConfiguracionCommand}"/>

                        </Grid>


                        <!-- NUEVA -->

                        <Button
            Text="＋  Nueva configuración"
            HeightRequest="52"
            CornerRadius="15"
            BackgroundColor="#2563EB"
            TextColor="White"
            FontAttributes="Bold"
            Command="{Binding NuevaConfiguracionCommand}"/>


                        <!-- ================================================= -->
                        <!-- FORMULARIO -->
                        <!-- ================================================= -->

                        <Frame
            IsVisible="{Binding MostrarFormularioConfiguracion}"
            BackgroundColor="#0F172A"
            CornerRadius="16"
            Padding="15"
            HasShadow="False">

                            <VerticalStackLayout
                Spacing="12">

                                <Label
                    Text="DATOS DE FACTURACIÓN"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#94A3B8"/>


                                <!-- CAJERO -->

                                <Label
                    Text="Cajero"
                    FontSize="13"
                    TextColor="#CBD5E1"/>

                                <Frame
                    BackgroundColor="#334155"
                    CornerRadius="12"
                    Padding="12,0"
                    HeightRequest="52"
                    HasShadow="False">

                                    <Picker
                        ItemsSource="{Binding Cajeros}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding CajeroConfiguracion}"
                        TextColor="White"
                        Title="Selecciona un cajero"
                        TitleColor="#64748B"/>

                                </Frame>


                                <!-- SERIE -->

                                <Label
                    Text="Serie"
                    FontSize="13"
                    TextColor="#CBD5E1"/>

                                <Frame
                    BackgroundColor="#334155"
                    CornerRadius="12"
                    Padding="12,0"
                    HeightRequest="52"
                    HasShadow="False">

                                    <Entry
                        Text="{Binding SerieConfiguracion}"
                        Placeholder="Ej: 001"
                        PlaceholderColor="#64748B"
                        TextColor="White"
                        FontSize="16"/>

                                </Frame>


                                <!-- TIPO -->

                                <Label
                    Text="Tipo"
                    FontSize="13"
                    TextColor="#CBD5E1"/>

                                <Frame
                    BackgroundColor="#334155"
                    CornerRadius="12"
                    Padding="12,0"
                    HeightRequest="52"
                    HasShadow="False">

                                    <Picker
                        SelectedItem="{Binding TipoConfiguracion}"
                        TextColor="White">

                                        <Picker.Items>
                                            <x:String>NORMAL</x:String>
                                            <x:String>ELECTRONICA</x:String>
                                        </Picker.Items>

                                    </Picker>

                                </Frame>


                                <!-- BOTONES -->

                                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">

                                    <Button
                        Text="CANCELAR"
                        HeightRequest="50"
                        CornerRadius="14"
                        BackgroundColor="#475569"
                        TextColor="White"
                        Command="{Binding CancelarConfiguracionCommand}"/>

                                    <Button
                        Grid.Column="1"
                        Text="{Binding TextoGuardarConfiguracion}"
                        HeightRequest="50"
                        CornerRadius="14"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        FontAttributes="Bold"
                        Command="{Binding GuardarConfiguracionCommand}"/>

                                </Grid>

                            </VerticalStackLayout>

                        </Frame>


                        <!-- ================================================= -->
                        <!-- LISTA -->
                        <!-- ================================================= -->

                        <Label
            Text="CONFIGURACIONES REGISTRADAS"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="#94A3B8"/>


                        <CollectionView
            ItemsSource="{Binding ConfiguracionesFacturacion}"
            SelectionMode="None">

                            <CollectionView.EmptyView>

                                <Label
                    Text="No hay configuraciones registradas."
                    TextColor="#64748B"
                    HorizontalOptions="Center"
                    Margin="0,20"/>

                            </CollectionView.EmptyView>


                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Frame
                        BackgroundColor="#0F172A"
                        CornerRadius="16"
                        Padding="15"
                        Margin="0,0,0,10"
                        HasShadow="False">

                                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                                            <!-- INFORMACIÓN -->

                                            <VerticalStackLayout
                                VerticalOptions="Center"
                                Spacing="3">

                                                <Label
                                    Text="{Binding Serie,
                                        StringFormat='Serie {0}'}"
                                    TextColor="White"
                                    FontSize="17"
                                    FontAttributes="Bold"/>

                                                <Label
                                    Text="{Binding Tipo}"
                                    TextColor="#60A5FA"
                                    FontSize="12"/>

                                                <Label
                                    Text="{Binding CajeroId,
                                        StringFormat='Cajero ID: {0}'}"
                                    TextColor="#64748B"
                                    FontSize="12"/>

                                                <Label
                                    Text="{Binding Id,
                                        StringFormat='ID: {0}'}"
                                    TextColor="#475569"
                                    FontSize="11"/>

                                            </VerticalStackLayout>


                                            <!-- BOTONES -->

                                            <HorizontalStackLayout
                                Grid.Column="1"
                                Spacing="6"
                                VerticalOptions="Center">

                                                <!-- EDITAR -->

                                                <Button
                                    Text="✎"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#334155"
                                    TextColor="White"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.EditarConfiguracionCommand}"
                                    CommandParameter="{Binding}"/>


                                                <!-- DESACTIVAR -->

                                                <Button
                                    Text="×"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#7F1D1D"
                                    TextColor="White"
                                    IsVisible="{Binding Activa}"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.DesactivarConfiguracionCommand}"
                                    CommandParameter="{Binding}"/>


                                                <!-- ACTIVAR -->

                                                <Button
                                    Text="✓"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#166534"
                                    TextColor="White"
                                    IsVisible="{Binding Activa,
                                        Converter={StaticResource
                                        InverseBoolConverter}}"
                                    Command="{Binding
                                        Source={RelativeSource
                                        AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.ActivarConfiguracionCommand}"
                                    CommandParameter="{Binding}"/>

                                            </HorizontalStackLayout>

                                        </Grid>

                                    </Frame>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>
                <!-- ================================================= -->
                <!-- MENSAJE -->
                <!-- ================================================= -->

                <Frame
                    IsVisible="{Binding Mensaje,
                        Converter={StaticResource StringNotEmptyConverter}}"
                    BackgroundColor="#1E293B"
                    CornerRadius="16"
                    Padding="16"
                    HasShadow="False">

                    <Label
                        Text="{Binding Mensaje}"
                        TextColor="White"
                        FontSize="14"/>

                </Frame>


                <!-- ================================================= -->
                <!-- HISTORIAL -->
                <!-- ================================================= -->

                <Label
    Text="HISTORIAL"
    FontSize="14"
    FontAttributes="Bold"
    TextColor="#94A3B8"
    Margin="0,10,0,0"/>

                <CollectionView
    ItemsSource="{Binding Jornadas}"
    SelectionMode="None">

                    <CollectionView.EmptyView>

                        <Label
            Text="Todavía no hay jornadas registradas."
            TextColor="#64748B"
            HorizontalOptions="Center"
            Margin="0,20"/>

                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Frame
                BackgroundColor="#1E293B"
                CornerRadius="16"
                Padding="16"
                Margin="0,0,0,10"
                HasShadow="False">

                                <VerticalStackLayout
                    Spacing="12">

                                    <!-- ========================================= -->
                                    <!-- INFORMACIÓN DE LA JORNADA -->
                                    <!-- ========================================= -->

                                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="10">

                                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                                            <Label
                                Text="{Binding Id,
                                    StringFormat='Jornada #{0}'}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"/>

                                            <Label
                                Text="{Binding FechaInicio,
                                    StringFormat='Inicio: {0}'}"
                                TextColor="#94A3B8"
                                FontSize="13"/>

                                            <Label
                                Text="{Binding FechaFin,
                                    StringFormat='Fin: {0}'}"
                                TextColor="#94A3B8"
                                FontSize="13"/>

                                        </VerticalStackLayout>

                                        <!-- ESTADO -->

                                        <Frame
                            Grid.Column="1"
                            BackgroundColor="#334155"
                            CornerRadius="10"
                            Padding="10,6"
                            HasShadow="False"
                            VerticalOptions="Center">

                                            <Label
                                Text="{Binding Estado}"
                                TextColor="#94A3B8"
                                FontSize="12"
                                FontAttributes="Bold"/>

                                        </Frame>

                                    </Grid>


                                    <!-- ========================================= -->
                                    <!-- BOTÓN EXPORTAR -->
                                    <!-- ========================================= -->

                                    <Button
                        Text="📊  EXPORTAR A EXCEL"
                        HeightRequest="48"
                        CornerRadius="14"
                        BackgroundColor="#166534"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        Command="{Binding
                            Source={RelativeSource
                            AncestorType={x:Type ContentPage}},
                            Path=BindingContext.ExportarJornadaCommand}"
                        CommandParameter="{Binding}"/>

                                </VerticalStackLayout>

                            </Frame>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>
            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>