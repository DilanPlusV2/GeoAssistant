<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="geocode.Pages.EntregaPage"
    BackgroundColor="#0F172A"
    Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="Auto,*">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid
            Padding="20,18"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="15">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="34"
                WidthRequest="50"
                HeightRequest="50"
                CornerRadius="25"
                BackgroundColor="#1E293B"
                TextColor="White"
                Clicked="OnVolver"/>

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="2">

                <Label
                    Text="ENTREGA DE PEDIDOS"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Registro rápido"
                    FontSize="13"
                    TextColor="#94A3B8"/>

            </VerticalStackLayout>

        </Grid>


        <!-- ===================================================== -->
        <!-- CONTENIDO -->
        <!-- ===================================================== -->

        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="20,10,20,30"
                Spacing="22">


                <!-- ================================================= -->
                <!-- FACTURA -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="FACTURA"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#CBD5E1"/>

                    <Border
                        BackgroundColor="#1E293B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        HeightRequest="62"
                        Padding="15,0">

                        <Entry
                            Text="{Binding NumeroFactura}"
                            Placeholder="26350"
                            PlaceholderColor="#64748B"
                            TextColor="White"
                            FontSize="22"
                            Keyboard="Numeric"
                            VerticalOptions="Center"/>

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- DOMICILIARIO -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="DOMICILIARIO"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#CBD5E1"/>


                    <!-- ================================================= -->
                    <!-- BOTÓN + Y LISTA -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="58,*"
                        ColumnSpacing="10"
                        HorizontalOptions="Fill">

                        <!-- ================================================= -->
                        <!-- BOTÓN AGREGAR -->
                        <!-- ================================================= -->

                        <Button
                            Grid.Column="0"
                            Text="+"
                            WidthRequest="58"
                            HeightRequest="58"
                            Padding="0"
                            CornerRadius="29"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontSize="30"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Command="{Binding NuevoDomiciliarioCommand}"/>


                        <!-- ================================================= -->
                        <!-- LISTA DE DOMICILIARIOS -->
                        <!-- ================================================= -->

                        <FlexLayout
                            Grid.Column="1"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start"
                            AlignContent="Start"
                            HorizontalOptions="Fill"
                            BindableLayout.ItemsSource="{Binding Domiciliarios}">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <Button
                                        Text="{Binding Codigo}"
                                        WidthRequest="58"
                                        HeightRequest="58"
                                        Margin="0,0,10,10"
                                        Padding="0"
                                        CornerRadius="29"
                                        BackgroundColor="#1E293B"
                                        TextColor="White"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Command="{Binding
                                            Source={RelativeSource
                                            AncestorType={x:Type ContentPage}},
                                            Path=BindingContext.SeleccionarDomiciliarioCommand}"
                                        CommandParameter="{Binding}"/>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </FlexLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- DOMICILIARIO SELECCIONADO -->
                    <!-- ================================================= -->

                    <Label
                        Text="{Binding CodigoDomiciliario,
                               StringFormat='Seleccionado: {0}'}"
                        TextColor="#60A5FA"
                        FontSize="14"
                        IsVisible="{Binding TieneDomiciliario}"/>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- REGISTRAR -->
                <!-- ================================================= -->

                <Button
                    Text="REGISTRAR ENTREGA"
                    HeightRequest="62"
                    CornerRadius="18"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold"
                    Command="{Binding RegistrarEntregaCommand}"/>


                <!-- ================================================= -->
                <!-- CONSULTAR ENTREGAS -->
                <!-- ================================================= -->

                <Button
                    Text="CONSULTAR ENTREGAS"
                    HeightRequest="58"
                    CornerRadius="18"
                    BackgroundColor="#334155"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnConsultarEntregas"/>


                <!-- ================================================= -->
                <!-- RESULTADO -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding MostrarResultado}"
                    BackgroundColor="#1E293B"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                    <VerticalStackLayout
                        Spacing="14">


                        <!-- ================================================= -->
                        <!-- TÍTULO -->
                        <!-- ================================================= -->

                        <Label
                            Text="✅ ENTREGA REGISTRADA"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#4ADE80"
                            IsVisible="{Binding ResultadoExitoso}"/>

                        <Label
                            Text="❌ NO SE PUDO REGISTRAR"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#F87171"
                            IsVisible="{Binding ResultadoFallido}"/>


                        <!-- ================================================= -->
                        <!-- INFORMACIÓN -->
                        <!-- ================================================= -->

                        <Grid
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnDefinitions="Auto,*"
                            RowSpacing="8"
                            ColumnSpacing="20"
                            IsVisible="{Binding ResultadoExitoso}">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Factura"
                                TextColor="#94A3B8"
                                FontSize="15"/>

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding ResultadoFactura}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"/>


                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Cajero"
                                TextColor="#94A3B8"
                                FontSize="15"/>

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding ResultadoCajero}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"/>


                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Domiciliario"
                                TextColor="#94A3B8"
                                FontSize="15"/>

                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding ResultadoDomiciliario}"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- ERROR -->
                        <!-- ================================================= -->

                        <Label
                            Text="{Binding Mensaje}"
                            TextColor="White"
                            FontSize="15"
                            IsVisible="{Binding ResultadoFallido}"/>


                        <!-- ================================================= -->
                        <!-- BEBIDAS -->
                        <!-- ================================================= -->

                        <VerticalStackLayout
                            IsVisible="{Binding MostrarBebidas}"
                            Spacing="12">

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#334155"
                                Margin="0,5"/>

                            <Label
                                Text="¿LLEVA BEBIDA?"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="White"/>


                            <!-- ================================================= -->
                            <!-- BEBIDAS -->
                            <!-- ================================================= -->

                            <VerticalStackLayout
                                Spacing="10"
                                BindableLayout.ItemsSource="{Binding Bebidas}">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate>

                                        <Button
                                            Text="{Binding Nombre}"
                                            HeightRequest="52"
                                            CornerRadius="14"
                                            BackgroundColor="#334155"
                                            TextColor="White"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            Command="{Binding
                                                Source={RelativeSource
                                                AncestorType={x:Type ContentPage}},
                                                Path=BindingContext.RegistrarBebidaCommand}"
                                            CommandParameter="{Binding}"/>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>


                            <!-- ================================================= -->
                            <!-- NINGUNA -->
                            <!-- ================================================= -->

                            <Button
                                Text="NINGUNA"
                                HeightRequest="52"
                                CornerRadius="14"
                                BackgroundColor="#475569"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                Command="{Binding NingunaBebidaCommand}"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ===================================================== -->
        <!-- MODAL NUEVO DOMICILIARIO -->
        <!-- ===================================================== -->

        <Grid
            Grid.RowSpan="2"
            BackgroundColor="#99000000"
            IsVisible="{Binding MostrarNuevoDomiciliario}"
            Padding="25"
            ZIndex="100">

            <Border
                BackgroundColor="#1E293B"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Padding="22"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <VerticalStackLayout
                    Spacing="16">


                    <!-- ================================================= -->
                    <!-- TÍTULO -->
                    <!-- ================================================= -->

                    <Label
                        Text="NUEVO DOMICILIARIO"
                        TextColor="White"
                        FontSize="21"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Registra los datos del domiciliario."
                        TextColor="#94A3B8"
                        FontSize="14"/>


                    <!-- ================================================= -->
                    <!-- CÓDIGO -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="CÓDIGO"
                            TextColor="#CBD5E1"
                            FontSize="13"
                            FontAttributes="Bold"/>

                        <Border
                            BackgroundColor="#0F172A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="14,0">

                            <Entry
                                Text="{Binding NuevoCodigoDomiciliario}"
                                Placeholder="Ej: D01"
                                PlaceholderColor="#64748B"
                                TextColor="White"
                                FontSize="17"
                                CharacterSpacing="1"
                                VerticalOptions="Center"/>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- NOMBRE -->
                    <!-- ================================================= -->

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="NOMBRE"
                            TextColor="#CBD5E1"
                            FontSize="13"
                            FontAttributes="Bold"/>

                        <Border
                            BackgroundColor="#0F172A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13"
                            HeightRequest="55"
                            Padding="14,0">

                            <Entry
                                Text="{Binding NuevoNombreDomiciliario}"
                                Placeholder="Nombre del domiciliario"
                                PlaceholderColor="#64748B"
                                TextColor="White"
                                FontSize="17"
                                VerticalOptions="Center"/>

                        </Border>

                    </VerticalStackLayout>


                    <!-- ================================================= -->
                    <!-- MENSAJE -->
                    <!-- ================================================= -->

                    <Label
                        Text="{Binding MensajeDomiciliario}"
                        TextColor="#F87171"
                        FontSize="14"
                        IsVisible="{Binding TieneMensajeDomiciliario}"/>


                    <!-- ================================================= -->
                    <!-- BOTONES -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Margin="0,5,0,0">

                        <Button
                            Grid.Column="0"
                            Text="CANCELAR"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="#334155"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Command="{Binding CancelarDomiciliarioCommand}"/>

                        <Button
                            Grid.Column="1"
                            Text="GUARDAR"
                            HeightRequest="52"
                            CornerRadius="14"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            Command="{Binding GuardarDomiciliarioCommand}"/>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>